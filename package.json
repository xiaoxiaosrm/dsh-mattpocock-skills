{
  "name": "@mattpocock-community/dsh-engineering-skills",
  "version": "0.5.0",
  "description": "DeepSeek Harness (DSH) bundle porting Matt Pocock's agent skills (39 skills from the engineering, productivity, misc, and in-progress buckets) into a native DSH skill plugin. Same skill bodies, DSH skill discovery, adapted for DSH 0.2.1-rc.5.",
  "license": "MIT",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoxiaosrm/dsh-mattpocock-skills.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "claude-code",
    "skills",
    "engineering",
    "productivity",
    "skill-bundle"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "sync:upstream": "node scripts/sync-upstream.mjs",
    "check:upstream": "node scripts/sync-upstream.mjs --check"
  },
  "files": [
    "skills",
    "upstream.json",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
